{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Auth": {
    "LocalOwnerId": "local"
  },
  "Database": {
    "Provider": "sqlite",
    "ConnectionString": "Data Source=.data/agentforge.db"
  },
  "Areas": {
    "Agents": {
      "Llm": {
        "BaseUrl": "https://nano-gpt.com/api/v1",
        "ApiKey": "<< in user secrets >>",
        "Timeout": "00:01:00",
        "UseFake": false
      },
      "MaxConcurrentRuns": 2,
      "Pricing": {
        "PromptTokenPerMillion": 0.50,
        "CompletionTokenPerMillion": 1.50
      }
    }
  }
}
